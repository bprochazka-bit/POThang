<?xml version="1.0" encoding="utf-8"?>
<!-- PurchaseTracker usually runs on a LAN host over plain http
     (e.g. http://192.168.1.20:5000), so cleartext is allowed. Prefer https
     behind your reverse proxy where you can; tokens travel in a header. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Lets a user-installed CA (self-signed LAN proxy) work. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
